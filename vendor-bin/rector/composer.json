{
    "require": {
        "php": "^8.1",
        "rector/rector": "^2.2.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Faker\\Rector\\": "../../rector/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Faker\\Rector\\Tests\\": "../../rector/tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.12"
        },
        "preferred-install": "dist",
        "sort-packages": true
    }
}
